#!/usr/bin/env bash
# Seed leftover StudioCart data for the Data migration wizard.
# Requires: WP-CLI, active publishpress-cart + publishpress-cart-compat.
#
# Primary (any environment):
#   wp ppcartcomp seed-migration
#   wp --path=/path/to/wordpress ppcartcomp seed-migration --count=10
#
# From this repo:
#   composer seed:migration
#   composer seed:migration -- --count=10
#   ./bin/seed-migration --count=10
#
# Env:
#   WP_CLI_BIN   path to wp (default: wp on PATH)
#   WP_PATH      WordPress root for --path= (overrides auto-detect)
#   PPCARTCOMP_SEED_USE_DDEV=0  disable auto ddev when .ddev/ is present

set -euo pipefail

ROOT="$(cd "$(dirname "$0")/.." && pwd)"
WP_BIN="${WP_CLI_BIN:-wp}"

run_via_ddev() {
  command -v ddev >/dev/null 2>&1 || return 1
  [[ -d "$ROOT/.ddev" ]] || return 1
  [[ "${PPCARTCOMP_SEED_USE_DDEV:-1}" != "0" ]] || return 1
  ddev describe >/dev/null 2>&1 || return 1
  exec ddev exec --dir=/var/www/html wp --path=.web ppcartcomp seed-migration "$@"
}

# Explicit WP_PATH: never auto-route through ddev.
if [[ -n "${WP_PATH:-}" ]]; then
  if ! command -v "$WP_BIN" >/dev/null 2>&1; then
    echo "WP-CLI not found (looked for: $WP_BIN). Install WP-CLI or set WP_CLI_BIN." >&2
    exit 1
  fi
  exec "$WP_BIN" --path="$WP_PATH" ppcartcomp seed-migration "$@"
fi

# This project's ddev site (optional convenience).
if run_via_ddev "$@"; then
  exit 0
fi

if ! command -v "$WP_BIN" >/dev/null 2>&1; then
  echo "WP-CLI not found (looked for: $WP_BIN)." >&2
  echo "Install WP-CLI, or run: wp --path=/path/to/wordpress ppcartcomp seed-migration" >&2
  if [[ -d "$ROOT/.ddev" ]]; then
    echo "Or with ddev: ddev seed-migration" >&2
  fi
  exit 1
fi

WP_PATH_ARGS=()
if [[ -f "$ROOT/.web/wp-load.php" ]]; then
  WP_PATH_ARGS=(--path="$ROOT/.web")
elif [[ -f "$ROOT/wp-load.php" ]]; then
  WP_PATH_ARGS=(--path="$ROOT")
elif [[ -f ./wp-load.php ]]; then
  WP_PATH_ARGS=(--path=.)
fi

if [[ ${#WP_PATH_ARGS[@]} -eq 0 ]]; then
  echo "Could not find WordPress. Set WP_PATH=/path/to/wordpress or run:" >&2
  echo "  wp --path=/path/to/wordpress ppcartcomp seed-migration" >&2
  exit 1
fi

exec "$WP_BIN" "${WP_PATH_ARGS[@]}" ppcartcomp seed-migration "$@"
